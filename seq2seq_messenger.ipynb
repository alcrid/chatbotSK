    {
      "cell_type": "markdown",
      "source": [
        "# Model building\n",
        "\n",
        "\n"
      ],
      "metadata": {
        "id": "mow2dBe55zco"
      }
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "7c48edSO4ZHp"
      },
      "outputs": [],
      "source": [
        "\n",
        "EMBEDDING_DIM = 256\n",
        "encoder_inputs = Input(shape=(None, len(enword2idx), ), name=\"Encoder_input\")\n",
        "encoder_LSTM = LSTM(EMBEDDING_DIM, return_state=True, name='Encoder_lstm')\n",
        "encoder_outputs, state_h, state_c = encoder_LSTM(encoder_inputs)\n",
        "encoder_states = [state_h,state_c]\n",
        "\n",
        "\n",
        "decoder_inputs = Input(shape=(None,len(deword2idx) ),name = \"Decoder_input\")\n",
        "decoder_LSTM = LSTM(EMBEDDING_DIM, return_state=True, return_sequences=True, name=\"Decoder_lstm\")\n",
        "decoder_outputs, _, _ = decoder_LSTM(decoder_inputs, initial_state= encoder_states)\n",
        "decoder_dense = Dense(len(deword2idx), activation='softmax', name=\"Dense_layer\") \n",
        "decoder_outputs = decoder_dense(decoder_outputs) \n",
        "\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        ""
      ],
      "metadata": {
