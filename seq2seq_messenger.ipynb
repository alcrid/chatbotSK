    {
      "cell_type": "code",
      "source": [
        "filepath=\"drive/MyDrive/Data/training_progress2.hdf5\"\n",
        "checkpoint = ModelCheckpoint(filepath, monitor='val_accuracy', verbose=1, mode='max')\n",
